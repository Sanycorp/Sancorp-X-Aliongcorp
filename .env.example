# AEGIS-M / EL TZY — server secrets
#
# Copy to `.env.local` for `vercel dev`, and set the same names in the Vercel
# project (Settings → Environment Variables) for production and preview.
#
# Both values are read by the functions in /api. Nothing is baked into the
# client bundle — if they are missing the app stays fully usable on the FREE
# tier, but no license can be issued and the operator console stays locked.

# Signing key for license strings and session cookies.
# Any random string of 32+ characters. Rotating it revokes every session and
# every previously issued key — that is the whole revocation story.
AEGIS_SECRET=

# Password for the hidden operator console (#/control).
# Leave empty to keep the console permanently locked.
AEGIS_ADMIN_PASSWORD=

# Kunci operator AEGIS OPS. Buat dengan mesin, jangan diketik orang:
#   node -e "const a='0123456789ABCDEFGHJKMNPQRSTVWXYZ';const b=require('crypto').randomBytes(24);let o='';for(const x of b)o+=a[x&31];console.log('AEGIS-'+o.slice(0,24).match(/.{6}/g).join('-'))"
# 24 simbol = 120 bit. Masuk lewat tautan #/control?op=<kunci>, bukan diketik.
