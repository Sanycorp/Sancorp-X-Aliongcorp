{
  "name": "el-tzy-aegis",
  "private": true,
  "version": "8.17.0",
  "type": "module",
  "description": "Aegis Sound Lab by Sanayacorp \u2014 offline mecha audio forge. Web-native DSP, zero upload.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node tools/sri.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "cap:sync": "npm run build && cap sync android",
    "cap:open": "cap open android",
    "android:apk": "npm run build && cap sync android && node tools/android-harden.mjs && cd android && ./gradlew assembleDebug",
    "icons": "node tools/make-icons.mjs",
    "security:audit": "node tools/audit-headers.mjs",
    "android:harden": "node tools/android-harden.mjs"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "dompurify": "3.4.17"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
