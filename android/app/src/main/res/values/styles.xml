<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash: dark plate so the mecha boot never flashes white. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/icon_bg</item>
        <item name="android:navigationBarColor">@color/icon_bg</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/icon_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/icon_bg</item>
        <item name="android:navigationBarColor">@color/icon_bg</item>
    </style>
</resources>
